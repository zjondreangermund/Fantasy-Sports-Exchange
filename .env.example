# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fantasy_sports

# Server
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Frontend API base (used by Capacitor/mobile builds)
VITE_API_URL=https://fantasy-sports-exchange-production-b10a.up.railway.app

# Session & Auth
SESSION_SECRET=change_me_to_a_random_secure_string_min_32_chars

# Google OAuth (for production)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin Users (comma-separated Google user IDs)
ADMIN_USER_IDS=your_google_user_id_1,your_google_user_id_2

# API-Football / API-Sports
# Fantasy Arena is intentionally hard-locked to the English Premier League (API-Football league 39).
# Keep the real key in Railway variables; never commit it to GitHub.
API_FOOTBALL_KEY=your_api_football_key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_SYNC_ENABLED=true

# Pro-mode safety/scheduling defaults.
# Pro currently provides 7,500 requests/day; Fantasy Arena intentionally caps itself
# at 7,000 and protects a provider-aware reserve. Rate-limit headers remain authoritative.
API_FOOTBALL_DAILY_CAP=7000
API_FOOTBALL_EMERGENCY_RESERVE=500
API_FOOTBALL_FIXTURE_SYNC_HOURS=2
API_FOOTBALL_LIVE_POLL_MINUTES=1
API_FOOTBALL_COMPLETED_STATS_MINUTES=10
API_FOOTBALL_LINEUPS_POLL_MINUTES=5
API_FOOTBALL_INJURY_SYNC_MINUTES=60
API_FOOTBALL_TRANSFER_SYNC_HOURS=6
API_FOOTBALL_STANDINGS_SYNC_MINUTES=60

# Development/Testing Mode (local only; production always disables mock auth)
USE_MOCK_AUTH=false
MOCK_USER_ID=demo-buyer-1
MOCK_FIRST_NAME=Demo
MOCK_LAST_NAME=Buyer
MOCK_EMAIL=demo@local.test

# Replit (auto-set on Replit, leave empty otherwise)
# REPL_ID=